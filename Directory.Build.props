<Project>
  <PropertyGroup>
    <IsExternal Condition="$(MSBuildProjectDirectory.Replace('\', '/').Contains('/external/'))">true</IsExternal>
  </PropertyGroup>

  <PropertyGroup Condition="'$(IsExternal)' != 'true'">
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <!-- The ink submodule is built as-is; silence its warnings. -->
  <PropertyGroup Condition="'$(IsExternal)' == 'true'">
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CS0108;CS0114;CS0168;CS0169;CS0219;CS0414;CS0618;CS0649;CS1591;CS1572;CS1573;CS1574;CS1587;CS8632;NU1903</NoWarn>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <RunAnalyzers>false</RunAnalyzers>
  </PropertyGroup>
</Project>
