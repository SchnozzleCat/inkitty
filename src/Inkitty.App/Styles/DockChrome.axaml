<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:core="using:Dock.Model.Core"
                    xmlns:dmc="using:Dock.Model.Controls"
                    xmlns:controls="using:Dock.Avalonia.Controls"
                    xmlns:converters="using:Dock.Avalonia.Converters"
                    xmlns:docking="using:Inkitty.App.Docking"
                    x:CompileBindings="True">
  <!--
    Dock's drag chrome in Inkitty's look: what follows the pointer while dragging a pane, and the
    title bar of a floating pane. Colours come from ThemeService (InkittyPaneHeaderBackground etc.).
  -->

  <!--
    The label that follows the pointer: the pane title as in its header, and where it will land.
    Dock doesn't always re-measure it when the status changes, so its size never depends on the
    status: a fixed icon slot (the text "Dock"/"Float" widened it and was cut off).
  -->
  <ControlTheme x:Key="{x:Type controls:DragPreviewControl}" TargetType="controls:DragPreviewControl">
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{DynamicResource InkittyPaneHeaderBackground}"
                BorderBrush="{DynamicResource DockThemeAccentBrush}"
                BorderThickness="1"
                CornerRadius="5"
                Padding="10,0,8,0"
                MinHeight="28"
                x:DataType="core:IDockable">
          <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <TextBlock Text="{Binding Title}" FontSize="11" FontWeight="SemiBold" LetterSpacing="0.6"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}" />
            <Path x:Name="PART_StatusIcon" Width="11" Height="11" Stretch="Uniform" StrokeThickness="1.4"
                  StrokeLineCap="Round" StrokeJoin="Round" VerticalAlignment="Center" />
          </StackPanel>
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^ /template/ Path#PART_StatusIcon">
      <Setter Property="Stroke" Value="{DynamicResource DockThemeAccentBrush}" />
      <Setter Property="Opacity" Value="0" />
    </Style>
    <Style Selector="^[Status=Dock] /template/ Path#PART_StatusIcon">
      <Setter Property="Data" Value="{DynamicResource IconDockHere}" />
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="^[Status=Float] /template/ Path#PART_StatusIcon">
      <Setter Property="Data" Value="{DynamicResource IconFloat}" />
      <Setter Property="Opacity" Value="1" />
    </Style>
  </ControlTheme>

  <!--
    Context menus. Panes in Inkitty only dock, tab and float, so Dock's menus are cut down to that: no
    auto hide/pin, float all, dock as document, new document docks, cascade/tile or layout modes (most of
    which did nothing here, or made the floating window disappear). Same keys as Dock's, so they replace them.
  -->

  <!-- A floating pane's title bar (MdiDocumentWindow). DataContext: the managed window document. -->
  <ContextMenu x:Key="MdiDocumentWindowContextMenu" x:DataType="core:IDockable">
    <MenuItem Header="_Close"
              Command="{Binding Owner.Factory.CloseDockable}"
              CommandParameter="{Binding}" />
  </ContextMenu>

  <!-- A tool's tab (when tools share a pane). DataContext: the tool. -->
  <ContextMenu x:Key="ToolTabStripItemContextMenu" x:DataType="core:IDockable">
    <MenuItem Header="_Float"
              Command="{Binding Owner.Factory.FloatDockable}"
              CommandParameter="{Binding}"
              IsVisible="{Binding Converter={x:Static docking:DockConverters.IsInMainWindow}}" />
    <MenuItem Header="_Auto Hide"
              Command="{Binding Owner.Factory.PinDockable}"
              CommandParameter="{Binding}"
              IsVisible="{Binding Converter={x:Static docking:DockConverters.CanPin}}" />
    <MenuItem Header="_Close"
              Command="{Binding Owner.Factory.CloseDockable}"
              CommandParameter="{Binding}" />
  </ContextMenu>

  <!-- The tab on the window edge of an auto-hidden tool. DataContext: the tool. -->
  <ContextMenu x:Key="ToolPinItemControlContextMenu" x:DataType="core:IDockable">
    <MenuItem Header="_Show"
              Command="{Binding Owner.Factory.PreviewPinnedDockable}"
              CommandParameter="{Binding}" />
    <MenuItem Header="_Unpin"
              Command="{Binding Owner.Factory.PinDockable}"
              CommandParameter="{Binding}" />
    <MenuItem Header="_Close"
              Command="{Binding Owner.Factory.CloseDockable}"
              CommandParameter="{Binding}" />
  </ContextMenu>

  <!-- The ⋯ menu on a floating pane's title bar, and Dock's tool title bars. DataContext: the tool dock. -->
  <MenuFlyout x:Key="ToolChromeControlContextMenu" x:DataType="dmc:IToolDock">
    <MenuItem Header="_Close"
              Command="{Binding Owner.Factory.CloseDockable}"
              CommandParameter="{Binding ActiveDockable}" />
  </MenuFlyout>
</ResourceDictionary>
