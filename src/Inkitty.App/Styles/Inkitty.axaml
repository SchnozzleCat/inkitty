<Styles xmlns="https://github.com/avaloniaui"
        xmlns:controls="using:Inkitty.App.Controls"
        xmlns:core="using:Dock.Model.Core"
        xmlns:views="using:Inkitty.App.Views"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Styles.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://Inkitty.App/Styles/DockChrome.axaml" />
      </ResourceDictionary.MergedDictionaries>
      <!-- Theme-dependent brushes (InkittyPlayerBackground, InkittyMuted, ...) are provided at runtime
           by Services/ThemeService from the selected colour theme. -->
      <SolidColorBrush x:Key="InkittyError" Color="#FFE53935" />
      <SolidColorBrush x:Key="InkittyWarning" Color="#FFF5A623" />
      <SolidColorBrush x:Key="InkittyTodo" Color="#FF428BF5" />

      <!-- Icons as 16x16 outline geometries, drawn with Path strokes (icon-stroke) or fills: text symbols
           depend on system fonts the browser doesn't have. -->
      <StreamGeometry x:Key="IconRestart">M3.5,8 A4.5,4.5 0 1 0 5,4.6 M5.4,1.8 L5,4.6 L7.8,5</StreamGeometry>
      <StreamGeometry x:Key="IconStepBack">M3,6.5 L10,6.5 A3.5,3.5 0 0 1 10,13.5 L7,13.5 M5.8,3.7 L3,6.5 L5.8,9.3</StreamGeometry>
      <StreamGeometry x:Key="IconTarget">M8,2.5 A5.5,5.5 0 1 1 7.99,2.5 Z M8,6 A2,2 0 1 1 7.99,6 Z M8,0.5 L8,2.5 M8,13.5 L8,15.5 M0.5,8 L2.5,8 M13.5,8 L15.5,8</StreamGeometry>
      <StreamGeometry x:Key="IconCollapseAll">M2.5,2.5 L13.5,2.5 L13.5,13.5 L2.5,13.5 Z M5,8 L11,8</StreamGeometry>
      <StreamGeometry x:Key="IconExpandAll">M2.5,2.5 L13.5,2.5 L13.5,13.5 L2.5,13.5 Z M5,8 L11,8 M8,5 L8,11</StreamGeometry>
      <StreamGeometry x:Key="IconFolder">M1.5,3.5 L6,3.5 L7.5,5 L14.5,5 L14.5,13 L1.5,13 Z</StreamGeometry>
      <StreamGeometry x:Key="IconPencil">M2.5,13.5 L3.2,10.5 L10.5,3.2 L12.8,5.5 L5.5,12.8 Z M9.3,4.4 L11.6,6.7</StreamGeometry>
      <StreamGeometry x:Key="IconList">M2.5,4 L13.5,4 M2.5,8 L13.5,8 M2.5,12 L13.5,12</StreamGeometry>
      <StreamGeometry x:Key="IconDockHere">M2.5,2.5 L13.5,2.5 L13.5,13.5 L2.5,13.5 Z M2.5,9 L13.5,9</StreamGeometry>
      <StreamGeometry x:Key="IconFloat">M5.5,2.5 L13.5,2.5 L13.5,10.5 L5.5,10.5 Z M2.5,5.5 L2.5,13.5 L10.5,13.5</StreamGeometry>
      <StreamGeometry x:Key="IconPin">M6,2.5 L10,2.5 L9.5,7 L11.5,9 L4.5,9 L6.5,7 Z M8,9 L8,13.5</StreamGeometry>
      <StreamGeometry x:Key="IconClose">M4,4 L12,12 M12,4 L4,12</StreamGeometry>
      <StreamGeometry x:Key="IconInclude">M9,2.5 L13.5,2.5 L13.5,13.5 L9,13.5 M2,8 L10,8 M7,5 L10,8 L7,11</StreamGeometry>

      <!-- Dock layout: no boxes around panes or the editor, a hairline under the tab strip. -->
      <Thickness x:Key="DockDocumentContentBorderThickness">0</Thickness>
      <x:Double x:Key="DockDocumentTabStripSeparatorSize">1</x:Double>
      <Thickness x:Key="DockDocumentTabItemPadding">10,0,6,0</Thickness>
      <!-- 27 + the 1px line under the strip = a pane header's 28, so the editor's tab row lines up with
           the pane headers beside it. -->
      <x:Double x:Key="DockDocumentTabItemMinHeight">27</x:Double>
    </ResourceDictionary>
  </Styles.Resources>

  <!-- Dock panes: no Dock title bars (each tool view has its own PaneGrip header) and no outlines. -->
  <Style Selector="ToolChromeControl /template/ Border#PART_Border">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector="ToolChromeControl:pointerover /template/ Border#PART_Border">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector="ToolChromeControl /template/ Panel#PART_Panel">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector="ToolChromeControl:pointerover /template/ Panel#PART_Panel">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector="ToolControl /template/ Border#PART_Border">
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <!-- Dock drop selectors in the theme's colours (Theming/DockSelectorIcons, filled in by ThemeService). -->
  <Style Selector="DockTarget /template/ Image#PART_TopSelector, GlobalDockTarget /template/ Image#PART_TopSelector">
    <Setter Property="Source" Value="{DynamicResource InkittyDockSelectorTop}" />
  </Style>
  <Style Selector="DockTarget /template/ Image#PART_BottomSelector, GlobalDockTarget /template/ Image#PART_BottomSelector">
    <Setter Property="Source" Value="{DynamicResource InkittyDockSelectorBottom}" />
  </Style>
  <Style Selector="DockTarget /template/ Image#PART_LeftSelector, GlobalDockTarget /template/ Image#PART_LeftSelector">
    <Setter Property="Source" Value="{DynamicResource InkittyDockSelectorLeft}" />
  </Style>
  <Style Selector="DockTarget /template/ Image#PART_RightSelector, GlobalDockTarget /template/ Image#PART_RightSelector">
    <Setter Property="Source" Value="{DynamicResource InkittyDockSelectorRight}" />
  </Style>
  <Style Selector="DockTarget /template/ Image#PART_CenterSelector">
    <Setter Property="Source" Value="{DynamicResource InkittyDockSelectorCenter}" />
  </Style>

  <!-- Pane header (replaces Dock's title bar): the title in small caps-style lettering on a slightly
       darker strip with a hairline below; pin (auto hide) and close buttons show on hover, the pin stays
       visible (filled) while the pane is auto-hidden. Dragging it moves the pane. -->
  <Style Selector="controls|PaneGrip">
    <Setter Property="Height" Value="28" />
    <Setter Property="Background" Value="{DynamicResource InkittyPaneHeaderBackground}" />
    <Setter Property="Foreground" Value="{DynamicResource InkittyMuted}" />
    <Setter Property="Template">
      <ControlTemplate>
        <!-- Dock starts a drag from a rendered drag area whose DataContext is the tool: this panel
             (made one in the :pointerover style below). -->
        <DockPanel Name="PART_DragArea" x:DataType="core:IDockable" Background="{TemplateBinding Background}">
          <Border DockPanel.Dock="Bottom" Height="1" Background="{DynamicResource DockThemeBorderLowBrush}" IsHitTestVisible="False" />
          <Button Name="PART_CloseButton" DockPanel.Dock="Right" Classes="pane-close" ToolTip.Tip="Close">
            <Path Classes="icon small" Data="{StaticResource IconClose}" />
          </Button>
          <Button Name="PART_PinButton" DockPanel.Dock="Right" Classes="pane-close pane-pin">
            <Path Classes="icon small" Data="{StaticResource IconPin}" />
          </Button>
          <TextBlock Name="PART_Title" Text="{Binding Title}" Classes="pane-header-title" IsHitTestVisible="False" />
        </DockPanel>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="controls|PaneGrip TextBlock.pane-header-title">
    <Setter Property="Foreground" Value="{Binding $parent[controls:PaneGrip].Foreground}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LetterSpacing" Value="0.6" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Margin" Value="10,0,6,0" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>
  <Style Selector="controls|PaneGrip:pointerover">
    <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
  </Style>
  <!-- Dock looks for drag areas among everything under the pointer, even what's hidden behind a floating
       panel, so a header under a floating panel's title bar would start a second drag. Only the header the
       pointer is actually over (never a covered one) is a drag area. A header that moves its native
       floating window (:moves-window, see PaneGrip) starts a window move instead of a pane drag. -->
  <Style Selector="controls|PaneGrip:pointerover:not(:moves-window) /template/ DockPanel#PART_DragArea">
    <Setter Property="DockProperties.IsDragArea" Value="True" />
  </Style>
  <Style Selector="Button.pane-close">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Width" Value="22" />
    <Setter Property="Height" Value="22" />
    <Setter Property="Margin" Value="0,0,4,0" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource InkittyMuted}" />
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector="controls|PaneGrip:pointerover Button.pane-close">
    <Setter Property="IsVisible" Value="{Binding $parent[controls:PaneGrip].((core:IDockable)Dockable).CanClose, FallbackValue=False}" />
  </Style>
  <Style Selector="controls|PaneGrip:pointerover Button.pane-pin">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector="controls|PaneGrip:can-pin:pointerover Button.pane-pin, controls|PaneGrip:can-pin:pinned Button.pane-pin">
    <Setter Property="IsVisible" Value="True" />
  </Style>
  <Style Selector="Button.pane-pin">
    <Setter Property="Margin" Value="0" />
  </Style>
  <!-- Auto-hidden (sliding out from the edge): the pin is filled; clicking it unpins. -->
  <Style Selector="controls|PaneGrip:pinned Button.pane-pin Path">
    <Setter Property="Fill" Value="{Binding $self.Stroke}" />
  </Style>
  <Style Selector="Button.pane-close:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource InkittyChoiceHover}" />
    <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
  </Style>

  <Style Selector="controls|PaneGrip:floating">
    <Setter Property="IsVisible" Value="False" />
  </Style>

  <!-- Floating panes: the window's title bar looks like a pane header (no accent fill, no grip dots). -->
  <Style Selector="MdiDocumentWindow /template/ Border#PART_Header">
    <Setter Property="Background" Value="{DynamicResource InkittyPaneHeaderBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource DockThemeBorderLowBrush}" />
    <Setter Property="MinHeight" Value="28" />
  </Style>
  <Style Selector="MdiDocumentWindow:active /template/ Border#PART_Header">
    <Setter Property="Background" Value="{DynamicResource InkittyPaneHeaderBackground}" />
  </Style>
  <Style Selector="MdiDocumentWindow /template/ Border#PART_DragHandle">
    <Setter Property="Padding" Value="10,0,6,0" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
  </Style>
  <Style Selector="MdiDocumentWindow /template/ DockPanel#PART_ToolHeader TextBlock, MdiDocumentWindow /template/ Grid#PART_DocumentHeader TextBlock">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LetterSpacing" Value="0.6" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource InkittyMuted}" />
  </Style>
  <Style Selector="MdiDocumentWindow:active /template/ DockPanel#PART_ToolHeader TextBlock, MdiDocumentWindow:active /template/ Grid#PART_DocumentHeader TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
  </Style>
  <Style Selector="MdiDocumentWindow /template/ Grid#PART_Grid">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector="MdiDocumentWindow /template/ Path">
    <Setter Property="Fill" Value="{DynamicResource InkittyMuted}" />
  </Style>
  <Style Selector="MdiDocumentWindow:active /template/ Path">
    <Setter Property="Fill" Value="{DynamicResource InkittyMuted}" />
  </Style>
  <Style Selector="MdiDocumentWindow /template/ Button:pointerover Path">
    <Setter Property="Fill" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
  </Style>

  <!-- Pane dividers: a hairline centred in the (wider, easy to grab) splitter. -->
  <Style Selector="ProportionalStackPanelSplitter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel Background="Transparent">
          <Border Name="PART_Line" Background="{DynamicResource DockThemeBorderLowBrush}" />
        </Panel>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="ProportionalStackPanelSplitter:horizontal /template/ Border#PART_Line">
    <Setter Property="Width" Value="1" />
    <Setter Property="HorizontalAlignment" Value="Center" />
  </Style>
  <Style Selector="ProportionalStackPanelSplitter:vertical /template/ Border#PART_Line">
    <Setter Property="Height" Value="1" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="ProportionalStackPanelSplitter:pointerover /template/ Border#PART_Line">
    <Setter Property="Background" Value="{DynamicResource DockThemeAccentBrush}" />
  </Style>

  <!-- Document tabs: the selected tab blends into the editor; the accent is a thin top line. -->
  <Style Selector="DocumentTabStripItem">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource InkittyMuted}" />
  </Style>
  <Style Selector="DocumentTabStripItem /template/ Border#PART_TabBody">
    <Setter Property="BorderThickness" Value="0,2,0,0" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="DocumentTabStripItem:selected">
    <Setter Property="Background" Value="{DynamicResource InkittyEditorBackground}" />
    <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
  </Style>
  <Style Selector="DocumentTabStripItem:active:selected">
    <Setter Property="Background" Value="{DynamicResource InkittyEditorBackground}" />
    <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
  </Style>
  <Style Selector="DocumentTabStripItem:active:selected /template/ Border#PART_TabBody">
    <Setter Property="BorderBrush" Value="{DynamicResource DockThemeAccentBrush}" />
  </Style>
  <Style Selector="DocumentTabStripItem:pointerover:not(:selected)">
    <Setter Property="Background" Value="{DynamicResource InkittyChoiceBackground}" />
    <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
  </Style>
  <Style Selector="DocumentControl /template/ Panel#PART_DocumentSeperator">
    <Setter Property="Background" Value="{DynamicResource DockThemeBorderLowBrush}" />
  </Style>
  <Style Selector="DocumentControl:active /template/ Panel#PART_DocumentSeperator">
    <Setter Property="Background" Value="{DynamicResource DockThemeBorderLowBrush}" />
  </Style>

  <!-- General -->
  <Style Selector="TextBlock.placeholder">
    <Setter Property="Foreground" Value="{DynamicResource InkittyMuted}" />
    <Setter Property="Margin" Value="12" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="TextBlock.pane-header">
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Margin" Value="8,6" />
  </Style>
  <Style Selector="TextBlock.section">
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontSize" Value="15" />
  </Style>

  <!-- Keyboard shortcuts editor -->
  <Style Selector="Grid.shortcut-row">
    <Setter Property="Margin" Value="0,2" />
    <Setter Property="MinHeight" Value="32" />
  </Style>
  <Style Selector="TextBlock.shortcut-category">
    <Setter Property="Foreground" Value="{DynamicResource InkittyMuted}" />
    <Setter Property="FontSize" Value="11" />
  </Style>
  <Style Selector="TextBlock.shortcut-warning">
    <Setter Property="Foreground" Value="{StaticResource InkittyWarning}" />
    <Setter Property="FontSize" Value="11" />
  </Style>
  <Style Selector="TextBlock.shortcut-hint">
    <Setter Property="Foreground" Value="{DynamicResource InkittyMuted}" />
    <Setter Property="FontSize" Value="11" />
  </Style>
  <Style Selector="Button.shortcut">
    <Setter Property="FontFamily" Value="fonts:Inkitty#JetBrains Mono, monospace" />
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector="Button.shortcut.none">
    <Setter Property="Foreground" Value="{DynamicResource InkittyMuted}" />
  </Style>
  <Style Selector="Button.shortcut.recording">
    <Setter Property="BorderBrush" Value="{DynamicResource DockThemeAccentBrush}" />
    <Setter Property="BorderThickness" Value="1.5" />
    <Setter Property="FontStyle" Value="Italic" />
  </Style>

  <!-- Window chrome: menu bar and status bar share one colour. -->
  <Style Selector="DockPanel.menu-bar">
    <Setter Property="Background" Value="{DynamicResource InkittyChromeBackground}" />
  </Style>
  <Style Selector="Menu#InWindowMenu">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <!-- The app name at the start of the menu bar. -->
  <Style Selector="DockPanel.menu-bar TextBlock.app-name">
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Margin" Value="12,0,4,0" />
  </Style>
  <!-- Submenu arrow (shape and size are set in code, see ChevronTemplateFixes): stroked like the other icons. -->
  <Style Selector="MenuItem /template/ Path#PART_ChevronPath">
    <Setter Property="Stroke" Value="{DynamicResource MenuFlyoutSubItemChevron}" />
    <Setter Property="StrokeThickness" Value="1.5" />
    <Setter Property="StrokeLineCap" Value="Round" />
    <Setter Property="StrokeJoin" Value="Round" />
  </Style>
  <Style Selector="MenuItem:selected /template/ Path#PART_ChevronPath, MenuItem:open /template/ Path#PART_ChevronPath">
    <Setter Property="Stroke" Value="{DynamicResource MenuFlyoutSubItemChevronPointerOver}" />
  </Style>
  <Style Selector="MenuItem:disabled /template/ Path#PART_ChevronPath">
    <Setter Property="Stroke" Value="{DynamicResource MenuFlyoutSubItemChevronDisabled}" />
  </Style>
  <Style Selector="Window">
    <Setter Property="Background" Value="{DynamicResource SystemRegionBrush}" />
  </Style>
  <Style Selector="views|MainView">
    <Setter Property="Background" Value="{DynamicResource SystemRegionBrush}" />
  </Style>

  <!-- In-view modal dialogs (browser) -->
  <Style Selector="Border.modal-backdrop">
    <Setter Property="Background" Value="#66000000" />
  </Style>
  <Style Selector="Border.modal-card">
    <Setter Property="Background" Value="{DynamicResource SystemRegionBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseLowBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="BoxShadow" Value="0 8 32 0 #50000000" />
    <Setter Property="MaxWidth" Value="720" />
  </Style>
  <Style Selector="TextBlock.modal-title">
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Margin" Value="20,14,20,0" />
  </Style>

  <!-- Status bar -->
  <Style Selector="Border.statusbar">
    <Setter Property="Padding" Value="8,2" />
    <Setter Property="Background" Value="{DynamicResource InkittyChromeBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseLowBrush}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
  </Style>
  <Style Selector="Border.statusbar TextBlock">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.statusbar TextBlock.version">
    <Setter Property="Foreground" Value="{DynamicResource InkittyMuted}" />
    <Setter Property="Margin" Value="0,0,16,0" />
  </Style>
  <Style Selector="Button.counts">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="6,1" />
  </Style>
  <Style Selector="TextBlock.count.error">
    <Setter Property="Foreground" Value="{StaticResource InkittyError}" />
  </Style>
  <Style Selector="TextBlock.count.warning">
    <Setter Property="Foreground" Value="{StaticResource InkittyWarning}" />
  </Style>
  <Style Selector="TextBlock.count.todo">
    <Setter Property="Foreground" Value="{StaticResource InkittyTodo}" />
  </Style>

  <!-- Files tree -->
  <Style Selector="TextBlock.unincluded">
    <Setter Property="Foreground" Value="{DynamicResource InkittyMuted}" />
    <Setter Property="FontStyle" Value="Italic" />
  </Style>
  <Style Selector="TextBlock.header">
    <Setter Property="Foreground" Value="{DynamicResource InkittyMuted}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.has-errors">
    <Setter Property="Foreground" Value="{StaticResource InkittyError}" />
  </Style>
  <Style Selector="TextBlock.dirty">
    <Setter Property="Foreground" Value="{DynamicResource InkittyMuted}" />
    <Setter Property="FontSize" Value="10" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBlock.folder">
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.outline-icon">
    <Setter Property="Foreground" Value="{DynamicResource InkittyMuted}" />
    <Setter Property="FontFamily" Value="fonts:Inkitty#JetBrains Mono, monospace" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="MinWidth" Value="16" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- Issues and Variables: the list sits on the pane's background, like the filter bar above it. -->
  <Style Selector="ListBox.issues, ListBox.variables">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <!-- Issues -->
  <Style Selector="ListBox.issues ListBoxItem">
    <Setter Property="Padding" Value="6,3" />
    <Setter Property="MinHeight" Value="0" />
  </Style>
  <Style Selector="Ellipse.error">
    <Setter Property="Fill" Value="{StaticResource InkittyError}" />
  </Style>
  <Style Selector="Ellipse.warning">
    <Setter Property="Fill" Value="{StaticResource InkittyWarning}" />
  </Style>
  <Style Selector="Ellipse.todo">
    <Setter Property="Fill" Value="{StaticResource InkittyTodo}" />
  </Style>
  <Style Selector="TextBlock.location">
    <Setter Property="Foreground" Value="{DynamicResource InkittyMuted}" />
    <Setter Property="FontSize" Value="12" />
  </Style>
  <!-- Outline -->
  <Style Selector="WrapPanel.outline-toolbar">
    <Setter Property="Margin" Value="6,6,6,2" />
    <Setter Property="ItemSpacing" Value="4" />
  </Style>
  <!-- Tree expanders: the same chevron as submenus (see ChevronTemplateFixes), turning down when open. -->
  <Style Selector="ToggleButton#PART_ExpandCollapseChevron /template/ Path#ChevronPath">
    <Setter Property="Stroke" Value="{DynamicResource InkittyMuted}" />
    <Setter Property="StrokeThickness" Value="1.5" />
    <Setter Property="StrokeLineCap" Value="Round" />
    <Setter Property="StrokeJoin" Value="Round" />
    <Setter Property="RenderTransform" Value="rotate(0deg)" />
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="ToggleButton#PART_ExpandCollapseChevron:checked /template/ Path#ChevronPath">
    <Setter Property="RenderTransform" Value="rotate(90deg)" />
  </Style>
  <Style Selector="ListBox.outline">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ListBox.outline ListBoxItem">
    <Setter Property="MinHeight" Value="24" />
    <Setter Property="Padding" Value="4,0" />
  </Style>
  <!-- The outline's own fold toggle (rows are flat, so there is no TreeViewItem expander): the same chevron. -->
  <Style Selector="ToggleButton.outline-expander">
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="20" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}">
          <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="ToggleButton.outline-expander Path.chevron">
    <Setter Property="Width" Value="6" />
    <Setter Property="Height" Value="9" />
    <Setter Property="Stroke" Value="{DynamicResource InkittyMuted}" />
    <Setter Property="StrokeThickness" Value="1.5" />
    <Setter Property="StrokeLineCap" Value="Round" />
    <Setter Property="StrokeJoin" Value="Round" />
    <Setter Property="RenderTransform" Value="rotate(0deg)" />
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="ToggleButton.outline-expander:checked Path.chevron">
    <Setter Property="RenderTransform" Value="rotate(90deg)" />
  </Style>
  <Style Selector="Border.outline-expander-space">
    <Setter Property="Width" Value="16" />
  </Style>
  <Style Selector="TextBlock.outline-name">
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBlock.outline-name.flow">
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.outline-detail">
    <Setter Property="Foreground" Value="{DynamicResource InkittyMuted}" />
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>
  <!-- Conditions read like code (as on the story map): editor font, the theme's keyword colour. -->
  <!-- A choice's label, e.g. (shouted): first, as in the source; muted, as it names rather than shows. -->
  <Style Selector="TextBlock.outline-label">
    <Setter Property="FontFamily" Value="fonts:Inkitty#JetBrains Mono, monospace" />
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="Foreground" Value="{DynamicResource InkittyMuted}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBlock.outline-condition">
    <Setter Property="FontFamily" Value="fonts:Inkitty#JetBrains Mono, monospace" />
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="Foreground" Value="{DynamicResource InkittyValueKeyword}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBlock.outline-icon.flow">
    <Setter Property="Foreground" Value="{DynamicResource InkittyValueFunction}" />
  </Style>
  <Style Selector="TextBlock.outline-icon.weave">
    <Setter Property="Foreground" Value="{DynamicResource InkittyValueKeyword}" />
  </Style>

  <!-- Variables -->
  <Style Selector="DockPanel.variables-toolbar">
    <Setter Property="Margin" Value="6,6,6,2" />
  </Style>
  <Style Selector="TextBox.filter-box">
    <Setter Property="MinHeight" Value="26" />
    <Setter Property="Padding" Value="8,3" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Margin" Value="0,0,6,0" />
  </Style>
  <Style Selector="ListBox.variables ListBoxItem">
    <Setter Property="Padding" Value="0" />
    <Setter Property="MinHeight" Value="0" />
  </Style>
  <Style Selector="ListBox.variables Grid">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ListBox.variables Grid.just-changed">
    <Setter Property="Background" Value="{DynamicResource InkittyNewHighlight}" />
  </Style>
  <Style Selector="TextBlock.variable-name">
    <Setter Property="FontFamily" Value="fonts:Inkitty#JetBrains Mono, monospace" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="MinWidth" Value="140" />
    <Setter Property="Margin" Value="10,3,16,3" />
    <Setter Property="Foreground" Value="{DynamicResource InkittyMuted}" />
  </Style>
  <Style Selector="TextBlock.variable-name.changed">
    <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.variable-value">
    <Setter Property="FontFamily" Value="fonts:Inkitty#JetBrains Mono, monospace" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="Margin" Value="0,3,10,3" />
  </Style>
  <Style Selector="TextBlock.variable-value.number">
    <Setter Property="Foreground" Value="{DynamicResource InkittyValueNumber}" />
  </Style>
  <Style Selector="TextBlock.variable-value.bool">
    <Setter Property="Foreground" Value="{DynamicResource InkittyValueKeyword}" />
  </Style>
  <Style Selector="TextBlock.variable-value.string">
    <Setter Property="Foreground" Value="{DynamicResource InkittyValueString}" />
  </Style>
  <Style Selector="TextBlock.variable-value.divert">
    <Setter Property="Foreground" Value="{DynamicResource InkittyValueFunction}" />
  </Style>

  <Style Selector="StackPanel.issue-filters">
    <Setter Property="Orientation" Value="Horizontal" />
    <Setter Property="Spacing" Value="2" />
    <Setter Property="Margin" Value="6,6,6,2" />
  </Style>
  <!-- Issue filters: quiet toggles with a coloured dot; "on" is a soft pill, "off" is dimmed. -->
  <Style Selector="ToggleButton.filter">
    <Setter Property="Padding" Value="8,3" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Opacity" Value="0.55" />
  </Style>
  <Style Selector="ToggleButton.filter:checked">
    <Setter Property="Opacity" Value="1" />
  </Style>
  <Style Selector="ToggleButton.filter:checked /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource InkittyTagBackground}" />
    <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
  </Style>
  <Style Selector="ToggleButton.filter:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource InkittyChoiceHover}" />
    <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
  </Style>
  <Style Selector="ToggleButton.filter:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource InkittyChoiceBackground}" />
  </Style>
  <Style Selector="ToggleButton.filter TextBlock.count">
    <Setter Property="Foreground" Value="{DynamicResource InkittyMuted}" />
  </Style>
  <Style Selector="ToggleButton.filter Ellipse">
    <Setter Property="Width" Value="7" />
    <Setter Property="Height" Value="7" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- Editor info bar -->
  <Style Selector="Border.infobar">
    <Setter Property="Background" Value="{DynamicResource InkittyInfoBar}" />
    <Setter Property="Padding" Value="10,6" />
  </Style>

  <!-- Player -->
  <Style Selector="StackPanel.player-toolbar">
    <Setter Property="Orientation" Value="Horizontal" />
    <Setter Property="Spacing" Value="2" />
    <Setter Property="Margin" Value="6,6,6,0" />
  </Style>
  <!-- Stroked icons (see the Icon* geometries) -->
  <Style Selector="Path.icon">
    <Setter Property="Width" Value="14" />
    <Setter Property="Height" Value="14" />
    <Setter Property="Stretch" Value="Uniform" />
    <Setter Property="Stroke" Value="{Binding $parent[ContentPresenter].Foreground}" />
    <Setter Property="StrokeThickness" Value="1.4" />
    <Setter Property="StrokeLineCap" Value="Round" />
    <Setter Property="StrokeJoin" Value="Round" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Path.icon.small">
    <Setter Property="Width" Value="11" />
    <Setter Property="Height" Value="11" />
    <Setter Property="StrokeThickness" Value="1.3" />
  </Style>
  <!-- The folder is wider than tall, so a uniform stretch leaves it at the top of the square icon box,
       above the text's lowercase letters. A shorter box (its aspect) centres it on them, nudged down to
       sit with the x-height rather than the full line. After Path.icon.small, which it overrides. -->
  <Style Selector="Path.folder-icon">
    <Setter Property="Stroke" Value="{DynamicResource InkittyMuted}" />
    <Setter Property="Width" Value="12" />
    <Setter Property="Height" Value="9" />
    <Setter Property="Margin" Value="2,1,0,0" />
  </Style>
  <!-- Flat toolbar buttons: no fill until hovered. -->
  <Style Selector="Button.flat">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="8,4" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="CornerRadius" Value="5" />
  </Style>
  <Style Selector="Button.flat:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource InkittyChoiceHover}" />
  </Style>
  <Style Selector="Button.flat:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <!-- Player: where am I? -->
  <Style Selector="Button.location">
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="Margin" Value="6,2,6,4" />
    <Setter Property="Padding" Value="8,2" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource InkittyMuted}" />
  </Style>
  <Style Selector="Button.location TextBlock.pin">
    <Setter Property="Foreground" Value="{DynamicResource DockThemeAccentBrush}" />
    <Setter Property="FontSize" Value="9" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <!-- "Show in editor" arrows: faint, brighter when hovering a transcript line. -->
  <Style Selector="Button.reveal">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="4,0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="VerticalAlignment" Value="Top" />
    <Setter Property="Opacity" Value="0.3" />
    <Setter Property="Foreground" Value="{DynamicResource InkittyMuted}" />
  </Style>
  <Style Selector="Grid:pointerover > Button.reveal">
    <Setter Property="Opacity" Value="1" />
  </Style>

  <!-- Story map -->
  <Style Selector="DockPanel.map-toolbar">
    <Setter Property="Margin" Value="4,2,10,2" />
  </Style>
  <Style Selector="WrapPanel.map-toolbar">
    <Setter Property="ItemSpacing" Value="2" />
  </Style>
  <!-- "n of m visited", on the right of the toolbar. -->
  <Style Selector="DockPanel.map-toolbar TextBlock.summary">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource InkittyMuted}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Margin" Value="12,0,0,0" />
  </Style>
  <Style Selector="TextBlock.pane-title">
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource InkittyMuted}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Margin" Value="4,0,8,0" />
  </Style>
  <Style Selector="WrapPanel.map-legend">
    <Setter Property="Margin" Value="10,4" />
  </Style>
  <Style Selector="WrapPanel.map-legend > StackPanel">
    <Setter Property="Orientation" Value="Horizontal" />
    <Setter Property="Spacing" Value="5" />
    <Setter Property="Margin" Value="0,0,14,0" />
  </Style>
  <Style Selector="WrapPanel.map-legend TextBlock">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{DynamicResource InkittyMuted}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.swatch">
    <Setter Property="Width" Value="14" />
    <Setter Property="Height" Value="10" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.swatch.current">
    <Setter Property="Background" Value="{DynamicResource DockThemeAccentBrush}" />
  </Style>
  <Style Selector="Border.swatch.visited">
    <Setter Property="BorderBrush" Value="{DynamicResource DockThemeAccentBrush}" />
    <Setter Property="BorderThickness" Value="1.5" />
  </Style>
  <Style Selector="Border.swatch.path">
    <Setter Property="Height" Value="3" />
    <Setter Property="Background" Value="{DynamicResource DockThemeAccentBrush}" />
  </Style>
  <Style Selector="Line.swatch-line">
    <Setter Property="Stroke" Value="{DynamicResource InkittyMuted}" />
    <Setter Property="StrokeThickness" Value="1.5" />
    <Setter Property="Width" Value="18" />
    <Setter Property="Height" Value="10" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.swatch.unvisited">
    <Setter Property="BorderBrush" Value="{DynamicResource InkittyMuted}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <Style Selector="ScrollViewer#Scroller">
    <Setter Property="Background" Value="{DynamicResource InkittyPlayerBackground}" />
  </Style>
  <Style Selector="ScrollViewer#Scroller SelectableTextBlock">
    <Setter Property="Foreground" Value="{DynamicResource InkittyPlayerForeground}" />
  </Style>
  <Style Selector="StackPanel.transcript">
    <Setter Property="Margin" Value="18,12" />
    <Setter Property="Spacing" Value="10" />
  </Style>
  <Style Selector="ScrollViewer.stale StackPanel.transcript">
    <Setter Property="Opacity" Value="0.45" />
  </Style>
  <!-- Padded and rounded so the "new" highlight reads as a soft card. Always padded (not just when
       new) so the text doesn't shift when the highlight fades. -->
  <Style Selector="Border.paragraph">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="12,8" />
  </Style>
  <Style Selector="Border.paragraph SelectableTextBlock">
    <Setter Property="FontSize" Value="15" />
    <Setter Property="LineHeight" Value="23" />
  </Style>
  <Style Selector="Border.paragraph.new">
    <Setter Property="Background" Value="{DynamicResource InkittyNewHighlight}" />
  </Style>
  <!-- Consecutive paragraphs draw as one block: only the run's outer corners are rounded. -->
  <Style Selector="Border.paragraph.joins-above">
    <Setter Property="CornerRadius" Value="0,0,8,8" />
    <Setter Property="Padding" Value="12,3,12,8" />
  </Style>
  <Style Selector="Border.paragraph.joins-below">
    <Setter Property="CornerRadius" Value="8,8,0,0" />
    <Setter Property="Padding" Value="12,8,12,3" />
  </Style>
  <Style Selector="Border.paragraph.joins-above.joins-below">
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Padding" Value="12,3" />
  </Style>
  <!-- Same side padding as a paragraph, so the "show in editor" arrows line up. -->
  <Style Selector="Grid.echo-row">
    <Setter Property="Margin" Value="12,4" />
  </Style>
  <Style Selector="TextBlock.echo">
    <Setter Property="Foreground" Value="{DynamicResource InkittyMuted}" />
    <Setter Property="Margin" Value="16,0,0,0" />
  </Style>
  <Style Selector="TextBlock.echo Run.choice-text">
    <Setter Property="FontStyle" Value="Italic" />
  </Style>
  <Style Selector="Border.divider">
    <Setter Property="Height" Value="1" />
    <Setter Property="Margin" Value="40,4" />
    <Setter Property="Background" Value="{DynamicResource SystemControlForegroundBaseLowBrush}" />
  </Style>
  <Style Selector="TextBlock.end">
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource InkittyMuted}" />
    <Setter Property="Margin" Value="0,12" />
  </Style>
  <Style Selector="Border.tag">
    <Setter Property="Background" Value="{DynamicResource InkittyTagBackground}" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="7,1" />
    <Setter Property="Margin" Value="0,4,4,0" />
  </Style>
  <Style Selector="Border.tag TextBlock">
    <Setter Property="FontSize" Value="11" />
  </Style>
  <Style Selector="Border.runtime-error">
    <Setter Property="BorderBrush" Value="{StaticResource InkittyError}" />
    <Setter Property="BorderThickness" Value="3,0,0,0" />
    <Setter Property="Padding" Value="8,4" />
  </Style>
  <Style Selector="Border.runtime-error.warning">
    <Setter Property="BorderBrush" Value="{StaticResource InkittyWarning}" />
  </Style>
  <Style Selector="ItemsControl.choices">
    <Setter Property="Margin" Value="0,8,0,0" />
  </Style>
  <Style Selector="Button.choice">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="Background" Value="{DynamicResource InkittyChoiceBackground}" />
    <Setter Property="Margin" Value="0,3" />
    <Setter Property="Padding" Value="12,7" />
    <Setter Property="CornerRadius" Value="6" />
  </Style>
  <Style Selector="Button.choice /template/ ContentPresenter">
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="3,0,0,0" />
  </Style>
  <Style Selector="Button.choice:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource InkittyChoiceHover}" />
    <Setter Property="BorderBrush" Value="{DynamicResource DockThemeAccentBrush}" />
  </Style>
  <Style Selector="Border.stale-banner">
    <Setter Property="Background" Value="{DynamicResource InkittyInfoBar}" />
    <Setter Property="Padding" Value="10,6" />
  </Style>
</Styles>
