<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Inkitty.App"
             x:Class="Inkitty.App.App"
             Name="Inkitty"
             RequestedThemeVariant="Default">
  <Application.DataTemplates>
    <local:ViewLocator />
  </Application.DataTemplates>

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://Dock.Avalonia.Themes.Fluent/Presets/Ide/Default.axaml" />
        <ResourceDictionary>
          <ControlRecycling x:Key="ControlRecyclingKey" TryToUseIdAsKey="True" />
        </ResourceDictionary>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <!-- Palettes are set at runtime from the selected colour theme (Services/ThemeService). -->
    <FluentTheme />
    <DockFluentTheme DensityStyle="Compact" />
    <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml" />
    <StyleInclude Source="avares://Inkitty.App/Styles/Inkitty.axaml" />

    <!-- Keep editor views (undo history, scroll position, highlighting) alive across tab switches and moves. -->
    <Style Selector="DockControl">
      <Setter Property="(ControlRecyclingDataTemplate.ControlRecycling)" Value="{StaticResource ControlRecyclingKey}" />
    </Style>
  </Application.Styles>
</Application>
