<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Inkitty.App.ViewModels"
             x:Class="Inkitty.App.Views.SettingsView"
             x:DataType="vm:SettingsViewModel"
             Width="520">
  <StackPanel Margin="20" Spacing="14">
    <TextBlock Classes="section" Text="Saving" />
    <Grid ColumnDefinitions="180,*" RowDefinitions="Auto,Auto" RowSpacing="8">
      <TextBlock Grid.Row="0" Text="Auto-save" VerticalAlignment="Center" />
      <ComboBox Grid.Row="0" Grid.Column="1" x:Name="AutoSaveBox" ItemsSource="{Binding AutoSaveModes}" SelectedItem="{Binding AutoSave}" HorizontalAlignment="Stretch" />
      <TextBlock Grid.Row="1" Text="Delay after last edit (ms)" VerticalAlignment="Center" />
      <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding AutoSaveDelayMs}" Minimum="200" Maximum="60000" Increment="100"
                     IsEnabled="{Binding IsAutoSaveDelayEnabled}" FormatString="0" />
    </Grid>

    <TextBlock Classes="section" Text="Appearance" />
    <Grid ColumnDefinitions="180,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="8">
      <TextBlock Grid.Row="0" Text="Colour theme" VerticalAlignment="Center" />
      <ComboBox Grid.Row="0" Grid.Column="1" x:Name="ThemeBox" ItemsSource="{Binding Themes}" SelectedItem="{Binding Theme}"
                HorizontalAlignment="Stretch" MaxDropDownHeight="420">
        <ComboBox.ItemTemplate>
          <DataTemplate DataType="vm:ThemeChoice">
            <DockPanel>
              <ItemsControl DockPanel.Dock="Left" ItemsSource="{Binding Swatches}" Margin="0,0,10,0" VerticalAlignment="Center">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="IBrush">
                    <Border Width="12" Height="16" Background="{Binding}" BorderBrush="#40808080" BorderThickness="0.5" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock DockPanel.Dock="Right" Text="{Binding Kind}" Opacity="0.6" FontSize="11" VerticalAlignment="Center" Margin="10,0,0,0" />
              <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" />
            </DockPanel>
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
      <TextBlock Grid.Row="1" Text="Editor font" VerticalAlignment="Center" />
      <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding EditorFontFamily}" />
      <TextBlock Grid.Row="2" Text="Editor font size" VerticalAlignment="Center" />
      <NumericUpDown Grid.Row="2" Grid.Column="1" Value="{Binding EditorFontSize}" Minimum="6" Maximum="72" Increment="1" FormatString="0" />
      <CheckBox Grid.Row="3" Grid.Column="1" Content="Word wrap" IsChecked="{Binding WordWrap}" />
    </Grid>

    <TextBlock Classes="section" Text="Editing &amp; playback" />
    <Grid ColumnDefinitions="180,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="8">
      <TextBlock Grid.Row="0" Text="Recompile delay (ms)" VerticalAlignment="Center" />
      <NumericUpDown Grid.Row="0" Grid.Column="1" Value="{Binding CompileDebounceMs}" Minimum="50" Maximum="5000" Increment="50" FormatString="0" />
      <TextBlock Grid.Row="1" Text="Replay time limit (ms)" VerticalAlignment="Center" />
      <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding ReplayTimeBudgetMs}" Minimum="100" Maximum="60000" Increment="100" FormatString="0" />
      <TextBlock Grid.Row="2" Text="Reachability playthroughs" VerticalAlignment="Center"
                 ToolTip.Tip="How many times the Reachable check plays the story, with random choices" />
      <NumericUpDown Grid.Row="2" Grid.Column="1" Value="{Binding ReachabilityRuns}" Minimum="1" Maximum="100000" Increment="50" FormatString="0" />
      <CheckBox Grid.Row="3" Grid.Column="1" Content="{Binding AltClickLabel}" IsChecked="{Binding AltClickNavigates}" />
    </Grid>

    <TextBlock Classes="section" Text="Keyboard" />
    <Grid ColumnDefinitions="180,*">
      <TextBlock Text="Shortcuts" VerticalAlignment="Center" />
      <Button Grid.Column="1" Content="Edit keyboard shortcuts…" Click="OnEditShortcuts" />
    </Grid>

    <DockPanel Margin="0,8,0,0">
      <Button DockPanel.Dock="Right" Content="Close" IsDefault="True" Click="OnClose" />
      <Button Content="Reset to defaults" Command="{Binding ResetToDefaultsCommand}" />
    </DockPanel>
  </StackPanel>
</UserControl>
