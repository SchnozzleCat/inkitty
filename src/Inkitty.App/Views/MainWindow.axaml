<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Inkitty.App.ViewModels"
        x:Class="Inkitty.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding WindowTitle}"
        Width="1400" Height="860" MinWidth="640" MinHeight="400"
        WindowStartupLocation="CenterScreen"
        Icon="avares://Inkitty.App/Assets/Icons/inkitty.png"
        xmlns:views="using:Inkitty.App.Views">
  <NativeMenu.Menu>
    <NativeMenu>
      <NativeMenuItem Header="File">
        <NativeMenu>
          <NativeMenuItem Header="New Project…" Command="{Binding NewProjectCommand}" Gesture="Cmd+N" />
          <NativeMenuItem Header="Open…" Command="{Binding OpenCommand}" Gesture="Cmd+O" />
          <NativeMenuItemSeparator />
          <NativeMenuItem Header="Save" Command="{Binding SaveCommand}" Gesture="Cmd+S" />
          <NativeMenuItem Header="Save All" Command="{Binding SaveAllCommand}" Gesture="Cmd+Shift+S" />
          <NativeMenuItem Header="Export Project as .zip…" Command="{Binding ExportProjectCommand}" />
          <NativeMenuItemSeparator />
          <NativeMenuItem Header="Close Tab" Command="{Binding CloseDocumentCommand}" Gesture="Cmd+W" />
          <NativeMenuItem Header="Close Project" Command="{Binding CloseProjectCommandCommand}" />
        </NativeMenu>
      </NativeMenuItem>
      <NativeMenuItem Header="Go">
        <NativeMenu>
          <NativeMenuItem Header="Go to Definition" Command="{Binding GoToDefinitionCommand}" Gesture="F12" />
          <NativeMenuItem Header="Back" Command="{Binding GoBackCommand}" Gesture="Ctrl+OemMinus" />
          <NativeMenuItem Header="Forward" Command="{Binding GoForwardCommand}" Gesture="Ctrl+Shift+OemMinus" />
          <NativeMenuItemSeparator />
          <NativeMenuItem Header="Next Issue" Command="{Binding NextIssueCommand}" Gesture="F8" />
          <NativeMenuItem Header="Previous Issue" Command="{Binding PreviousIssueCommand}" Gesture="Shift+F8" />
        </NativeMenu>
      </NativeMenuItem>
      <NativeMenuItem Header="Story">
        <NativeMenu>
          <NativeMenuItem Header="Restart Story" Command="{Binding RestartStoryCommand}" Gesture="Cmd+R" />
          <NativeMenuItem Header="Step Back" Command="{Binding StepBackStoryCommand}" />
          <NativeMenuItemSeparator />
          <NativeMenuItem Header="Show Current Line" Command="{Binding RevealStoryPositionCommand}" Gesture="Cmd+J" />
          <NativeMenuItem Header="Map" Command="{Binding ShowStoryMapCommand}" Gesture="Cmd+Shift+M" />
        </NativeMenu>
      </NativeMenuItem>
      <NativeMenuItem Header="View">
        <NativeMenu>
          <NativeMenuItem Header="Files" Command="{Binding ShowFilesCommand}" />
          <NativeMenuItem Header="Outline" Command="{Binding ShowOutlineCommand}" />
          <NativeMenuItem Header="Player" Command="{Binding ShowPlayerCommand}" />
          <NativeMenuItem Header="Issues" Command="{Binding ShowIssuesCommand}" />
          <NativeMenuItem Header="Map" Command="{Binding ShowStoryMapCommand}" />
          <NativeMenuItem Header="Variables" Command="{Binding ShowVariablesCommand}" />
          <NativeMenuItemSeparator />
          <NativeMenuItem Header="Reset Layout" Command="{Binding ResetLayoutCommand}" />
        </NativeMenu>
      </NativeMenuItem>
    </NativeMenu>
  </NativeMenu.Menu>

  <views:MainView x:Name="View" />
</Window>
