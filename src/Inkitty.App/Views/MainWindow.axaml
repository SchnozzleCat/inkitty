<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Inkitty.App.ViewModels"
        xmlns:input="using:Inkitty.App.Input"
        x:Class="Inkitty.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding WindowTitle}"
        Width="1400" Height="860" MinWidth="640" MinHeight="400"
        WindowStartupLocation="CenterScreen"
        Icon="avares://Inkitty.App/Assets/Icons/inkitty.png"
        xmlns:views="using:Inkitty.App.Views">
  <NativeMenu.Menu>
    <NativeMenu>
      <NativeMenuItem Header="File">
        <NativeMenu>
          <NativeMenuItem Header="New Project…" Command="{Binding NewProjectCommand}" input:Shortcut.Id="file.new" />
          <NativeMenuItem Header="Open…" Command="{Binding OpenCommand}" input:Shortcut.Id="file.open" />
          <NativeMenuItemSeparator />
          <NativeMenuItem Header="Save" Command="{Binding SaveCommand}" input:Shortcut.Id="file.save" />
          <NativeMenuItem Header="Save All" Command="{Binding SaveAllCommand}" input:Shortcut.Id="file.saveAll" />
          <NativeMenuItem Header="Export Project as .zip…" Command="{Binding ExportProjectCommand}" input:Shortcut.Id="file.export" />
          <NativeMenuItemSeparator />
          <NativeMenuItem Header="Close Tab" Command="{Binding CloseDocumentCommand}" input:Shortcut.Id="file.closeTab" />
          <NativeMenuItem Header="Close Project" Command="{Binding CloseProjectCommandCommand}" input:Shortcut.Id="file.closeProject" />
        </NativeMenu>
      </NativeMenuItem>
      <NativeMenuItem Header="Edit">
        <NativeMenu>
          <NativeMenuItem Header="Settings…" Command="{Binding OpenSettingsCommand}" input:Shortcut.Id="app.settings" />
          <NativeMenuItem Header="Keyboard Shortcuts…" Command="{Binding OpenKeyboardShortcutsCommand}" input:Shortcut.Id="app.keyboardShortcuts" />
        </NativeMenu>
      </NativeMenuItem>
      <NativeMenuItem Header="Go">
        <NativeMenu>
          <NativeMenuItem Header="Go to Definition" Command="{Binding GoToDefinitionCommand}" input:Shortcut.Id="go.definition" />
          <NativeMenuItem Header="Back" Command="{Binding GoBackCommand}" input:Shortcut.Id="go.back" />
          <NativeMenuItem Header="Forward" Command="{Binding GoForwardCommand}" input:Shortcut.Id="go.forward" />
          <NativeMenuItemSeparator />
          <NativeMenuItem Header="Next Issue" Command="{Binding NextIssueCommand}" input:Shortcut.Id="go.nextIssue" />
          <NativeMenuItem Header="Previous Issue" Command="{Binding PreviousIssueCommand}" input:Shortcut.Id="go.previousIssue" />
        </NativeMenu>
      </NativeMenuItem>
      <NativeMenuItem Header="Story">
        <NativeMenu>
          <NativeMenuItem Header="Restart Story" Command="{Binding RestartStoryCommand}" input:Shortcut.Id="story.restart" />
          <NativeMenuItem Header="Step Back" Command="{Binding StepBackStoryCommand}" input:Shortcut.Id="story.stepBack" />
          <NativeMenuItemSeparator />
          <NativeMenuItem Header="Show Current Line" Command="{Binding RevealStoryPositionCommand}" input:Shortcut.Id="story.showCurrentLine" />
          <NativeMenuItem Header="Map" Command="{Binding ShowStoryMapCommand}" input:Shortcut.Id="story.map" />
        </NativeMenu>
      </NativeMenuItem>
      <NativeMenuItem Header="View">
        <NativeMenu>
          <NativeMenuItem Header="Files" Command="{Binding ShowFilesCommand}" input:Shortcut.Id="view.files" />
          <NativeMenuItem Header="Outline" Command="{Binding ShowOutlineCommand}" input:Shortcut.Id="view.outline" />
          <NativeMenuItem Header="Player" Command="{Binding ShowPlayerCommand}" input:Shortcut.Id="view.player" />
          <NativeMenuItem Header="Issues" Command="{Binding ShowIssuesCommand}" input:Shortcut.Id="view.issues" />
          <NativeMenuItem Header="Map" Command="{Binding ShowStoryMapCommand}" input:Shortcut.Id="story.map" />
          <NativeMenuItem Header="Variables" Command="{Binding ShowVariablesCommand}" input:Shortcut.Id="view.variables" />
          <NativeMenuItemSeparator />
          <NativeMenuItem Header="Reset Layout" Command="{Binding ResetLayoutCommand}" input:Shortcut.Id="view.resetLayout" />
        </NativeMenu>
      </NativeMenuItem>
    </NativeMenu>
  </NativeMenu.Menu>

  <views:MainView x:Name="View" />
</Window>
