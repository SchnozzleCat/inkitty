<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Inkitty.App.ViewModels"
        x:Class="Inkitty.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding WindowTitle}"
        Width="1400" Height="860" MinWidth="640" MinHeight="400"
        WindowStartupLocation="CenterScreen"
        DragDrop.AllowDrop="True">
  <NativeMenu.Menu>
    <NativeMenu>
      <NativeMenuItem Header="File">
        <NativeMenu>
          <NativeMenuItem Header="New Project…" Command="{Binding NewProjectCommand}" Gesture="Cmd+N" />
          <NativeMenuItem Header="Open…" Command="{Binding OpenCommand}" Gesture="Cmd+O" />
          <NativeMenuItemSeparator />
          <NativeMenuItem Header="Save" Command="{Binding SaveCommand}" Gesture="Cmd+S" />
          <NativeMenuItem Header="Save All" Command="{Binding SaveAllCommand}" Gesture="Cmd+Shift+S" />
          <NativeMenuItemSeparator />
          <NativeMenuItem Header="Close Tab" Command="{Binding CloseDocumentCommand}" Gesture="Cmd+W" />
          <NativeMenuItem Header="Close Project" Command="{Binding CloseProjectCommandCommand}" />
        </NativeMenu>
      </NativeMenuItem>
      <NativeMenuItem Header="Go">
        <NativeMenu>
          <NativeMenuItem Header="Go to Definition" Command="{Binding GoToDefinitionCommand}" Gesture="F12" />
          <NativeMenuItem Header="Back" Command="{Binding GoBackCommand}" Gesture="Ctrl+OemMinus" />
          <NativeMenuItem Header="Forward" Command="{Binding GoForwardCommand}" Gesture="Ctrl+Shift+OemMinus" />
          <NativeMenuItemSeparator />
          <NativeMenuItem Header="Next Issue" Command="{Binding NextIssueCommand}" Gesture="F8" />
          <NativeMenuItem Header="Previous Issue" Command="{Binding PreviousIssueCommand}" Gesture="Shift+F8" />
        </NativeMenu>
      </NativeMenuItem>
      <NativeMenuItem Header="Story">
        <NativeMenu>
          <NativeMenuItem Header="Restart Story" Command="{Binding RestartStoryCommand}" Gesture="Cmd+R" />
          <NativeMenuItem Header="Step Back" Command="{Binding StepBackStoryCommand}" />
          <NativeMenuItemSeparator />
          <NativeMenuItem Header="Show Current Line" Command="{Binding RevealStoryPositionCommand}" Gesture="Cmd+J" />
          <NativeMenuItem Header="Story Map" Command="{Binding ShowStoryMapCommand}" Gesture="Cmd+Shift+M" />
        </NativeMenu>
      </NativeMenuItem>
      <NativeMenuItem Header="View">
        <NativeMenu>
          <NativeMenuItem Header="Files" Command="{Binding ShowFilesCommand}" />
          <NativeMenuItem Header="Player" Command="{Binding ShowPlayerCommand}" />
          <NativeMenuItem Header="Issues" Command="{Binding ShowIssuesCommand}" />
          <NativeMenuItem Header="Story Map" Command="{Binding ShowStoryMapCommand}" />
          <NativeMenuItemSeparator />
          <NativeMenuItem Header="Reset Layout" Command="{Binding ResetLayoutCommand}" />
        </NativeMenu>
      </NativeMenuItem>
    </NativeMenu>
  </NativeMenu.Menu>

  <DockPanel>
    <!-- In-window menu for Linux and Windows; macOS uses the native menu above. -->
    <Menu DockPanel.Dock="Top" x:Name="InWindowMenu">
      <MenuItem Header="_File">
        <MenuItem Header="_New Project…" Command="{Binding NewProjectCommand}" InputGesture="Ctrl+N" />
        <MenuItem Header="_Open…" Command="{Binding OpenCommand}" InputGesture="Ctrl+O" />
        <MenuItem x:Name="RecentMenu" Header="Open _Recent" ItemsSource="{Binding RecentProjects}" IsEnabled="{Binding HasRecentProjects}">
          <MenuItem.Styles>
            <!-- Only the generated children: a bare "MenuItem" selector would also match this item itself. -->
            <Style Selector="MenuItem#RecentMenu > MenuItem" x:DataType="x:String">
              <Setter Property="Header" Value="{Binding}" />
              <Setter Property="Command" Value="{Binding #InWindowMenu.((vm:MainWindowViewModel)DataContext).OpenRecentCommand}" />
              <Setter Property="CommandParameter" Value="{Binding}" />
            </Style>
          </MenuItem.Styles>
        </MenuItem>
        <Separator />
        <MenuItem Header="_Save" Command="{Binding SaveCommand}" InputGesture="Ctrl+S" />
        <MenuItem Header="Save _All" Command="{Binding SaveAllCommand}" InputGesture="Ctrl+Shift+S" />
        <Separator />
        <MenuItem Header="_Close Tab" Command="{Binding CloseDocumentCommand}" InputGesture="Ctrl+W" />
        <MenuItem Header="Close _Project" Command="{Binding CloseProjectCommandCommand}" />
        <Separator />
        <MenuItem Header="E_xit" Command="{Binding ExitCommand}" />
      </MenuItem>
      <MenuItem Header="_Edit">
        <MenuItem Header="_Settings…" Command="{Binding OpenSettingsCommand}" InputGesture="Ctrl+OemComma" />
      </MenuItem>
      <MenuItem Header="_Go">
        <MenuItem Header="Go to _Definition" Command="{Binding GoToDefinitionCommand}" InputGesture="F12" />
        <MenuItem Header="_Back" Command="{Binding GoBackCommand}" InputGesture="Alt+Left" />
        <MenuItem Header="_Forward" Command="{Binding GoForwardCommand}" InputGesture="Alt+Right" />
        <Separator />
        <MenuItem Header="_Next Issue" Command="{Binding NextIssueCommand}" InputGesture="F8" />
        <MenuItem Header="_Previous Issue" Command="{Binding PreviousIssueCommand}" InputGesture="Shift+F8" />
      </MenuItem>
      <MenuItem Header="_Story">
        <MenuItem Header="_Restart" Command="{Binding RestartStoryCommand}" InputGesture="Ctrl+R" />
        <MenuItem Header="Step _Back" Command="{Binding StepBackStoryCommand}" />
        <Separator />
        <MenuItem Header="Show _Current Line" Command="{Binding RevealStoryPositionCommand}" InputGesture="Ctrl+J" />
        <MenuItem Header="Story _Map" Command="{Binding ShowStoryMapCommand}" InputGesture="Ctrl+Shift+M" />
      </MenuItem>
      <MenuItem Header="_View">
        <MenuItem Header="_Files" Command="{Binding ShowFilesCommand}" />
        <MenuItem Header="_Player" Command="{Binding ShowPlayerCommand}" />
        <MenuItem Header="_Issues" Command="{Binding ShowIssuesCommand}" />
        <MenuItem Header="Story _Map" Command="{Binding ShowStoryMapCommand}" />
        <Separator />
        <MenuItem Header="_Reset Layout" Command="{Binding ResetLayoutCommand}" />
      </MenuItem>
    </Menu>

    <!-- Status bar -->
    <Border DockPanel.Dock="Bottom" Classes="statusbar">
      <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto">
        <ProgressBar Grid.Column="0" IsIndeterminate="True" Width="40" Height="4" Margin="0,0,8,0"
                     IsVisible="{Binding IsCompiling}" VerticalAlignment="Center" />
        <TextBlock Grid.Column="1" Text="{Binding CompileStatus}" Margin="0,0,16,0" />
        <TextBlock Grid.Column="2" Text="{Binding StatusText}" TextTrimming="CharacterEllipsis" />
        <TextBlock Grid.Column="3" Text="{Binding CaretText}" Margin="16,0" />
        <Button Grid.Column="4" Classes="counts" Command="{Binding ShowIssuesCommand}" ToolTip.Tip="Show issues">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBlock Classes="count error" Text="{Binding ErrorCount, StringFormat='● {0}'}" />
            <TextBlock Classes="count warning" Text="{Binding WarningCount, StringFormat='▲ {0}'}" />
            <TextBlock Classes="count todo" Text="{Binding TodoCount, StringFormat='✎ {0}'}" />
          </StackPanel>
        </Button>
      </Grid>
    </Border>

    <DockControl x:Name="DockControl" Layout="{Binding Layout}" InitializeLayout="False" InitializeFactory="False" />
  </DockPanel>
</Window>
