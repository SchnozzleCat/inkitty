<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tools="using:Inkitty.App.ViewModels.Tools"
             xmlns:controls="using:Inkitty.App.Controls"
             x:Class="Inkitty.App.Views.Tools.PlayerToolView"
             x:DataType="tools:PlayerToolViewModel">
  <Panel>
    <DockPanel>
      <controls:PaneGrip DockPanel.Dock="Top" Dockable="{Binding}" />
      <StackPanel DockPanel.Dock="Top" Classes="player-toolbar">
        <Button Classes="flat" Command="{Binding RestartCommand}">
          <StackPanel Orientation="Horizontal" Spacing="6"><Path Classes="icon" Data="{StaticResource IconRestart}" /><TextBlock Text="Restart" /></StackPanel>
        </Button>
        <Button Classes="flat" Command="{Binding StepBackCommand}" ToolTip.Tip="Undo the last choice">
          <StackPanel Orientation="Horizontal" Spacing="6"><Path Classes="icon" Data="{StaticResource IconStepBack}" /><TextBlock Text="Step back" /></StackPanel>
        </Button>
        <ProgressBar IsIndeterminate="True" Width="60" IsVisible="{Binding IsBusy}" VerticalAlignment="Center" Margin="8,0" />
      </StackPanel>
      <Button DockPanel.Dock="Top" Classes="flat location" IsVisible="{Binding HasLocation}"
              Command="{Binding RevealCommand}" CommandParameter="{x:Null}"
              ToolTip.Tip="Where the story is now. Click to show the line in the editor (Ctrl+J)">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <TextBlock Classes="pin" Text="●" />
          <TextBlock Text="{Binding LocationText}" TextTrimming="CharacterEllipsis" />
        </StackPanel>
      </Button>
      <Border DockPanel.Dock="Top" Classes="stale-banner" IsVisible="{Binding IsStale}">
        <TextBlock Text="{Binding StaleMessage}" TextWrapping="Wrap" />
      </Border>
      <TextBlock DockPanel.Dock="Top" Classes="placeholder" Text="{x:Static tools:Placeholders.NoProject}"
                 IsVisible="{Binding !HasProject}" />
      <ScrollViewer x:Name="Scroller" Classes.stale="{Binding IsStale}" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Classes="transcript">
          <ItemsControl ItemsSource="{Binding Items}">
            <ItemsControl.DataTemplates>
              <DataTemplate DataType="tools:PlayerParagraph">
                <StackPanel Classes="paragraph" Classes.new="{Binding IsNew}">
                  <Grid ColumnDefinitions="*,Auto">
                    <SelectableTextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                    <Button Grid.Column="1" Classes="reveal" IsVisible="{Binding HasSource}"
                            Command="{Binding $parent[UserControl].((tools:PlayerToolViewModel)DataContext).RevealCommand}"
                            CommandParameter="{Binding Source}"
                            ToolTip.Tip="{Binding SourceText, StringFormat='Show in editor ({0})'}">
                      <TextBlock Text="↗" />
                    </Button>
                  </Grid>
                  <ItemsControl ItemsSource="{Binding Tags}" IsVisible="{Binding HasTags}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <WrapPanel />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate DataType="x:String">
                        <Border Classes="tag">
                          <TextBlock Text="{Binding}" />
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </DataTemplate>
              <DataTemplate DataType="tools:PlayerChoiceEcho">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Classes="echo" Classes.new="{Binding IsNew}" Text="{Binding Text}" TextWrapping="Wrap" />
                  <Button Grid.Column="1" Classes="reveal" IsVisible="{Binding HasSource}"
                          Command="{Binding $parent[UserControl].((tools:PlayerToolViewModel)DataContext).RevealCommand}"
                          CommandParameter="{Binding Source}"
                          ToolTip.Tip="{Binding SourceText, StringFormat='Show in editor ({0})'}">
                    <TextBlock Text="↗" />
                  </Button>
                </Grid>
              </DataTemplate>
              <DataTemplate DataType="tools:PlayerTurnDivider">
                <Border Classes="divider" />
              </DataTemplate>
              <DataTemplate DataType="tools:PlayerEnd">
                <TextBlock Classes="end" Text="— THE END —" />
              </DataTemplate>
              <DataTemplate DataType="tools:PlayerError">
                <Border Classes="runtime-error" Classes.warning="{Binding IsWarning}">
                  <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
                </Border>
              </DataTemplate>
            </ItemsControl.DataTemplates>
          </ItemsControl>
          <ItemsControl ItemsSource="{Binding Choices}" Classes="choices">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="tools:PlayerChoice">
                <Button Classes="choice"
                        Command="{Binding $parent[UserControl].((tools:PlayerToolViewModel)DataContext).ChooseCommand}"
                        CommandParameter="{Binding}">
                  <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>
    </DockPanel>
  </Panel>
</UserControl>
