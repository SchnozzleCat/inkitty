<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tools="using:Inkitty.App.ViewModels.Tools"
             xmlns:map="using:Inkitty.App.StoryMap"
             xmlns:controls="using:Inkitty.App.Controls"
             x:Class="Inkitty.App.Views.Tools.StoryMapToolView"
             x:DataType="tools:StoryMapToolViewModel">
  <Panel>
    <DockPanel>
      <controls:PaneGrip DockPanel.Dock="Top" Dockable="{Binding}" />
      <DockPanel DockPanel.Dock="Top" Classes="map-toolbar">
        <TextBlock DockPanel.Dock="Right" Classes="summary" Text="{Binding Summary}" />
        <WrapPanel Classes="map-toolbar">
          <Button Classes="flat" Command="{Binding CenterOnCurrentCommand}" ToolTip.Tip="Centre the map on the current knot">
            <StackPanel Orientation="Horizontal" Spacing="6"><Path Classes="icon" Data="{StaticResource IconTarget}" /><TextBlock Text="Locate" /></StackPanel>
          </Button>
          <Button Classes="flat" Content="Fit" Command="{Binding FitToViewCommand}" ToolTip.Tip="Show the whole story (0). Ctrl+wheel or +/- zooms, drag pans." />
          <ToggleButton Classes="filter" IsChecked="{Binding FollowCurrent}" Content="Follow"
                        ToolTip.Tip="Keep the current knot in view as you play" />
        </WrapPanel>
      </DockPanel>
      <WrapPanel DockPanel.Dock="Bottom" Classes="map-legend">
        <StackPanel><Border Classes="swatch current" /><TextBlock Text="You are here" /></StackPanel>
        <StackPanel><Border Classes="swatch visited" /><TextBlock Text="Visited" /></StackPanel>
        <StackPanel><Border Classes="swatch path" /><TextBlock Text="Path taken" /></StackPanel>
        <StackPanel><Border Classes="swatch unvisited" /><TextBlock Text="Not yet" /></StackPanel>
        <StackPanel><Line Classes="swatch-line" StartPoint="0,5" EndPoint="18,5" StrokeDashArray="3,2" /><TextBlock Text="Conditional" /></StackPanel>
      </WrapPanel>
      <Panel>
        <map:StoryMapControl x:Name="Map"
                             Graph="{Binding Graph}"
                             Progress="{Binding Progress}"
                             FollowCurrent="{Binding FollowCurrent}"
                             ToolTip.ShowDelay="300" />
        <TextBlock Classes="placeholder" IsVisible="{Binding !HasProject}"
                   Text="{x:Static tools:Placeholders.NoProject}" />
      </Panel>
    </DockPanel>
  </Panel>
</UserControl>
