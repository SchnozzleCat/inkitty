<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tools="using:Inkitty.App.ViewModels.Tools"
             xmlns:controls="using:Inkitty.App.Controls"
             x:Class="Inkitty.App.Views.Tools.IssuesToolView"
             x:DataType="tools:IssuesToolViewModel">
  <Panel>
    <DockPanel>
      <StackPanel DockPanel.Dock="Top" Classes="issue-filters">
        <ToggleButton Classes="filter" IsChecked="{Binding ShowErrors}" ToolTip.Tip="Show errors">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Ellipse Classes="error" />
            <TextBlock Text="Errors" />
            <TextBlock Classes="count" Text="{Binding ErrorCount}" />
          </StackPanel>
        </ToggleButton>
        <ToggleButton Classes="filter" IsChecked="{Binding ShowWarnings}" ToolTip.Tip="Show warnings">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Ellipse Classes="warning" />
            <TextBlock Text="Warnings" />
            <TextBlock Classes="count" Text="{Binding WarningCount}" />
          </StackPanel>
        </ToggleButton>
        <ToggleButton Classes="filter" IsChecked="{Binding ShowTodos}" ToolTip.Tip="Show TODOs">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Ellipse Classes="todo" />
            <TextBlock Text="TODOs" />
            <TextBlock Classes="count" Text="{Binding TodoCount}" />
          </StackPanel>
        </ToggleButton>
      </StackPanel>
      <TextBlock DockPanel.Dock="Top" Classes="placeholder" Text="No issues" IsVisible="{Binding !Items.Count}" />
      <ListBox x:Name="List"
               ItemsSource="{Binding Items}"
               SelectedItem="{Binding SelectedItem}"
               DoubleTapped="OnDoubleTapped"
               KeyDown="OnKeyDown"
               Classes="issues">
        <ListBox.ItemTemplate>
          <DataTemplate DataType="tools:IssueItem">
            <Grid ColumnDefinitions="20,*,Auto">
              <Ellipse Grid.Column="0" Width="9" Height="9" VerticalAlignment="Center"
                       Classes.error="{Binding Severity, Converter={x:Static tools:IssueConverters.IsError}}"
                       Classes.warning="{Binding Severity, Converter={x:Static tools:IssueConverters.IsWarning}}"
                       Classes.todo="{Binding Severity, Converter={x:Static tools:IssueConverters.IsTodo}}" />
              <TextBlock Grid.Column="1" Text="{Binding Message}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Message}" />
              <TextBlock Grid.Column="2" Classes="location" Text="{Binding Location}" Margin="12,0,4,0" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>
    <controls:PaneGrip Dockable="{Binding}" />
  </Panel>
</UserControl>
