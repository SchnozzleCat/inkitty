<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Inkitty.App.ViewModels"
             xmlns:input="using:Inkitty.App.Input"
             xmlns:app="using:Inkitty.App"
             x:Class="Inkitty.App.Views.MainView"
             x:DataType="vm:MainWindowViewModel"
             DragDrop.AllowDrop="True">
  <Panel>
    <DockPanel x:Name="Shell">
      <!-- In-window menu bar (the app name, then the menu); hidden in a macOS window, which uses the native
           menu (MainWindow). -->
      <DockPanel DockPanel.Dock="Top" x:Name="MenuBar" Classes="menu-bar">
        <TextBlock DockPanel.Dock="Left" Classes="app-name" Text="Inkitty" />
        <Menu x:Name="InWindowMenu">
          <MenuItem Header="_File">
            <MenuItem Header="_New Project…" Command="{Binding NewProjectCommand}" input:Shortcut.Id="file.new" />
            <MenuItem Header="_Open…" Command="{Binding OpenCommand}" input:Shortcut.Id="file.open" />
            <MenuItem x:Name="RecentMenu" Header="Open _Recent" ItemsSource="{Binding RecentProjects}" IsEnabled="{Binding HasRecentProjects}">
              <MenuItem.Styles>
                <!-- Only the generated children: a bare "MenuItem" selector would also match this item itself. -->
                <Style Selector="MenuItem#RecentMenu > MenuItem" x:DataType="x:String">
                  <Setter Property="Header" Value="{Binding}" />
                  <Setter Property="Command" Value="{Binding #InWindowMenu.((vm:MainWindowViewModel)DataContext).OpenRecentCommand}" />
                  <Setter Property="CommandParameter" Value="{Binding}" />
                </Style>
              </MenuItem.Styles>
            </MenuItem>
            <Separator />
            <MenuItem Header="_Save" Command="{Binding SaveCommand}" input:Shortcut.Id="file.save" />
            <MenuItem Header="Save _All" Command="{Binding SaveAllCommand}" input:Shortcut.Id="file.saveAll" />
            <MenuItem Header="_Export Project as .zip…" Command="{Binding ExportProjectCommand}" input:Shortcut.Id="file.export" />
            <Separator />
            <MenuItem Header="_Close Tab" Command="{Binding CloseDocumentCommand}" input:Shortcut.Id="file.closeTab" />
            <MenuItem Header="Close _Project" Command="{Binding CloseProjectCommandCommand}" input:Shortcut.Id="file.closeProject" />
            <Separator x:Name="ExitSeparator" />
            <MenuItem x:Name="ExitMenuItem" Header="E_xit" Command="{Binding ExitCommand}" />
          </MenuItem>
          <MenuItem Header="_Edit">
            <MenuItem Header="_Settings…" Command="{Binding OpenSettingsCommand}" input:Shortcut.Id="app.settings" />
            <MenuItem Header="_Keyboard Shortcuts…" Command="{Binding OpenKeyboardShortcutsCommand}" input:Shortcut.Id="app.keyboardShortcuts" />
          </MenuItem>
          <MenuItem Header="_Go">
            <MenuItem Header="Go to _Definition" Command="{Binding GoToDefinitionCommand}" input:Shortcut.Id="go.definition" />
            <MenuItem Header="_Back" Command="{Binding GoBackCommand}" input:Shortcut.Id="go.back" />
            <MenuItem Header="_Forward" Command="{Binding GoForwardCommand}" input:Shortcut.Id="go.forward" />
            <Separator />
            <MenuItem Header="_Next Issue" Command="{Binding NextIssueCommand}" input:Shortcut.Id="go.nextIssue" />
            <MenuItem Header="_Previous Issue" Command="{Binding PreviousIssueCommand}" input:Shortcut.Id="go.previousIssue" />
          </MenuItem>
          <MenuItem Header="_Story">
            <MenuItem Header="_Restart" Command="{Binding RestartStoryCommand}" input:Shortcut.Id="story.restart" />
            <MenuItem Header="Step _Back" Command="{Binding StepBackStoryCommand}" input:Shortcut.Id="story.stepBack" />
            <Separator />
            <MenuItem Header="Show _Current Line" Command="{Binding RevealStoryPositionCommand}" input:Shortcut.Id="story.showCurrentLine" />
            <MenuItem Header="_Map" Command="{Binding ShowStoryMapCommand}" input:Shortcut.Id="story.map" />
          </MenuItem>
          <MenuItem Header="_View">
            <MenuItem Header="_Files" Command="{Binding ShowFilesCommand}" input:Shortcut.Id="view.files" />
            <MenuItem Header="_Outline" Command="{Binding ShowOutlineCommand}" input:Shortcut.Id="view.outline" />
            <MenuItem Header="_Player" Command="{Binding ShowPlayerCommand}" input:Shortcut.Id="view.player" />
            <MenuItem Header="_Issues" Command="{Binding ShowIssuesCommand}" input:Shortcut.Id="view.issues" />
            <MenuItem Header="_Map" Command="{Binding ShowStoryMapCommand}" input:Shortcut.Id="story.map" />
            <MenuItem Header="_Variables" Command="{Binding ShowVariablesCommand}" input:Shortcut.Id="view.variables" />
            <Separator />
            <MenuItem Header="_Reset Layout" Command="{Binding ResetLayoutCommand}" input:Shortcut.Id="view.resetLayout" />
          </MenuItem>
        </Menu>
      </DockPanel>

      <!-- Status bar -->
      <Border DockPanel.Dock="Bottom" Classes="statusbar">
        <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto">
          <TextBlock Grid.Column="0" x:Name="VersionText" Classes="version" Text="{x:Static app:AppVersion.Display}"
                     ToolTip.Tip="Inkitty version" />
          <ProgressBar Grid.Column="1" IsIndeterminate="True" Width="40" Height="4" Margin="0,0,8,0"
                       IsVisible="{Binding IsCompiling}" VerticalAlignment="Center" />
          <TextBlock Grid.Column="2" Text="{Binding CompileStatus}" Margin="0,0,16,0" />
          <TextBlock Grid.Column="3" Text="{Binding StatusText}" TextTrimming="CharacterEllipsis" />
          <TextBlock Grid.Column="4" Text="{Binding CaretText}" Margin="16,0" />
          <Button Grid.Column="5" Classes="counts" Command="{Binding ShowIssuesCommand}" ToolTip.Tip="Show issues">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <TextBlock Classes="count error" Text="{Binding ErrorCount, StringFormat='● {0}'}" />
              <TextBlock Classes="count warning" Text="{Binding WarningCount, StringFormat='▲ {0}'}" />
              <StackPanel Orientation="Horizontal" Spacing="4">
                <Path Classes="icon small" Stroke="{StaticResource InkittyTodo}" Data="{StaticResource IconPencil}" />
                <TextBlock Classes="count todo" Text="{Binding TodoCount}" />
              </StackPanel>
            </StackPanel>
          </Button>
        </Grid>
      </Border>

      <DockControl x:Name="DockControl" Layout="{Binding Layout}" InitializeLayout="False" InitializeFactory="False" />
    </DockPanel>

    <!-- Modal dialogs when there are no OS windows (browser): a stack of overlays; see ShowModalAsync. -->
    <Panel x:Name="ModalLayer" />
  </Panel>
</UserControl>
