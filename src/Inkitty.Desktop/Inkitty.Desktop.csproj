<Project Sdk="Microsoft.NET.Sdk">

  <!-- Desktop host (Linux, Windows, macOS). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>Inkitty.Desktop</RootNamespace>
    <AssemblyName>Inkitty</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon Condition="Exists('Assets\Icons\inkitty.ico')">Assets\Icons\inkitty.ico</ApplicationIcon>
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Wayland" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Inkitty.App\Inkitty.App.csproj" />
  </ItemGroup>

</Project>
