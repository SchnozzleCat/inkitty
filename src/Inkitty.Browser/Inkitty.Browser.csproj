<Project Sdk="Microsoft.NET.Sdk.WebAssembly">

  <!--
    Browser host (WebAssembly). Needs the wasm-tools workload: Onigwrap (TextMate regexes) is a
    native library that is linked into the runtime. Build with scripts/publish-web.sh or in CI.
  -->
  <PropertyGroup>
    <TargetFramework>net11.0-browser</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>Inkitty.Browser</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <!-- Required for Onigwrap; also lets us link Emscripten's IndexedDB file system. -->
    <WasmBuildNative>true</WasmBuildNative>
    <EmccExtraLDFlags>$(EmccExtraLDFlags) -lidbfs.js</EmccExtraLDFlags>
    <!-- Dock's layout serializer and the ink compiler use reflection: trim only framework assemblies. -->
    <TrimMode>partial</TrimMode>
    <SuppressTrimAnalysisWarnings>true</SuppressTrimAnalysisWarnings>
    <InvariantGlobalization>false</InvariantGlobalization>
    <!--
      Compile the hot path to WebAssembly ahead of time on publish (see AotAssemblies below): the ink
      compiler and runtime run several times faster than under the interpreter. The UI stays interpreted.
      Debug builds stay interpreted too (fast to build).
    -->
    <RunAOTCompilation Condition="'$(Configuration)' == 'Release'">true</RunAOTCompilation>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Browser" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Inkitty.App\Inkitty.App.csproj" />
  </ItemGroup>

  <!-- Seeded into the workspace on first visit: inkle's The Intercept (MIT, see samples/the-intercept). -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\samples\the-intercept\**\*.ink" LogicalName="Inkitty.Browser.Sample.%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <!--
    Only these assemblies are precompiled; the rest run on the interpreter. Precompiling everything makes
    dotnet.native.wasm about 61 MB, over Cloudflare Pages' 25 MiB per-file limit (and a slow first load).
    Matched by file name. Keep the published dotnet.native.*.wasm under 25 MiB when adding to this list:
    this set is about 20.4 MiB, and adding Inkitty.App or Avalonia.Base takes it to 25.7 MiB (also with
    -Oz, which saves almost nothing here).
  -->
  <ItemGroup>
    <AotAssemblies Include="ink_compiler;ink-engine-runtime;Inkitty.Core" />
    <AotAssemblies Include="System.Private.CoreLib;System.Linq;System.Collections" />
  </ItemGroup>

  <!-- Marks every other assembly for the interpreter (the WebAssembly SDK's hook for skipping assemblies). -->
  <Target Name="InterpretAssembliesNotOnTheHotPath" BeforeTargets="_WasmAotCompileApp" Condition="'$(RunAOTCompilation)' == 'true'">
    <ItemGroup>
      <_InkittyAllAssemblies Include="@(_WasmAssembliesInternal->'%(Filename)')" />
      <_InkittyInterpreted Include="@(_InkittyAllAssemblies)" Exclude="@(AotAssemblies)" />
      <_AOT_InternalForceInterpretAssemblies Include="@(_InkittyInterpreted->'%(Identity).dll')" />
    </ItemGroup>
    <Message Importance="high" Text="AOT: @(AotAssemblies->Count()) assemblies precompiled, @(_InkittyInterpreted->Count()) interpreted" />
  </Target>

  <ItemGroup>
    <StaticWebAssetFingerprintPattern Include="JS" Pattern="*.js" Expression="#[.{fingerprint}]!" />
  </ItemGroup>

</Project>
