# Hardening for the deploy tooling (wrangler). See README "Deploying".
# Never run install-time scripts (preinstall/install/postinstall/prepare) of any dependency.
# wrangler works without them: esbuild/workerd ship their binaries as optional platform packages.
ignore-scripts=true
# Only install versions that have been public for a week, so a freshly hijacked release
# is likely to be caught and pulled before it can land here.
min-release-age=7
# No dependencies fetched straight from git (they bypass the registry and can run `prepare`).
allow-git=none
# Exact versions only when adding/updating.
save-exact=true
# The lockfile is the source of truth: `npm ci` installs exactly it, with integrity hashes.
package-lock=true
engine-strict=true
audit=true
fund=false
update-notifier=false
